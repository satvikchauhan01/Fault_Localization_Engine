// Prisma schema matching Section F domain contracts and telemetry_inbox queue

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Used on Transformer: what the department has on file (ground-truth labelling)
// RECORDED = authoritative topology exists; MISSING = no topology on file
// 'INFERRED' is never stored here — inference is a runtime Topology Service concept.
enum GroundTruthTopologySource {
  RECORDED
  MISSING
}

// Used on TopologyEdge: how the runtime Topology Service derived this edge
// AUTHORITATIVE = built from recorded parent_pole_id; INFERRED = MST heuristic
enum EdgeTopologySource {
  AUTHORITATIVE
  INFERRED
}

enum TelemetryEventType {
  heartbeat
  power_lost
  power_restored
  boot
}

enum PoleStatus {
  LIVE
  CONFIRMED_DARK
  STALE
  OFFLINE_UNKNOWN
  SENSOR_SUSPECT
}

enum ScheduledOutageScope {
  DT
  FEEDER
  SPAN
}

enum IncidentType {
  SPAN
  DT
  FEEDER
  RANGE
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum TicketState {
  DETECTED
  ACKNOWLEDGED
  CREW_ASSIGNED
  RESOLVED
  VERIFIED
  CLOSED
}

enum SimulatorFaultType {
  SPAN
  DT
  FEEDER
}

enum InboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model Feeder {
  id        String   @id
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feeders")
}

model Transformer {
  id                String                  @id
  feeder_id         String                  @map("feeder_id")
  lat               Float
  lon               Float
  capacity_kva      Float                   @map("capacity_kva")
  households_served Int                     @map("households_served")
  // RECORDED = dept has topology on file; MISSING = no topology recorded.
  // The registry export (Step 5) sets this. Never INFERRED here.
  topology_source   GroundTruthTopologySource @map("topology_source")

  @@map("transformers")
}

model Pole {
  id             String   @id
  lat            Float
  lon            Float
  dt_id          String   @map("dt_id")
  feeder_id      String   @map("feeder_id")
  seq_on_line    Int?     @map("seq_on_line")
  parent_pole_id String?  @map("parent_pole_id")
  device_id      String?  @map("device_id")
  ward           String?
  pincode        String?

  @@map("poles")
}

model Device {
  id         String   @id
  pole_id    String?  @map("pole_id")
  fw_version String   @map("fw_version")
  first_seen DateTime @map("first_seen")
  last_seen  DateTime @map("last_seen")

  @@map("devices")
}

model TelemetryInbox {
  id                 String             @id @default(uuid())
  device_id          String             @map("device_id")
  pole_id            String             @map("pole_id")
  event              TelemetryEventType
  energized          Boolean
  device_ts          DateTime           @map("device_ts")
  seq                Int
  battery_mv         Int?               @map("battery_mv")
  rssi               Int?
  fw                 String
  server_received_at DateTime           @default(now()) @map("server_received_at")
  status             InboxStatus        @default(PENDING)
  processed_at       DateTime?          @map("processed_at")

  @@map("telemetry_inbox")
}

model PoleState {
  pole_id              String     @id @map("pole_id")
  status               PoleStatus
  last_confirmed_at    DateTime   @map("last_confirmed_at")
  last_event_seq       Int        @map("last_event_seq")
  evidence_summary     String     @map("evidence_summary")
  candidate_dark_since DateTime?  @map("candidate_dark_since")
  evidence_type        String     @map("evidence_type")

  @@map("pole_states")
}

model TopologyEdge {
  id             String             @id @default(uuid())
  parent_pole_id String             @map("parent_pole_id")
  child_pole_id  String             @map("child_pole_id")
  // AUTHORITATIVE = derived from recorded topology; INFERRED = MST heuristic (Step 8)
  source         EdgeTopologySource
  weight         Float?
  ambiguous      Boolean            @default(false)

  @@map("topology_edges")
}

model ScheduledOutage {
  id         String               @id
  scope      ScheduledOutageScope
  target_id  String               @map("target_id")
  start      DateTime
  end        DateTime
  reason     String
  fetched_at DateTime             @default(now()) @map("fetched_at")

  @@map("scheduled_outages")
}

model Incident {
  id                       String             @id
  type                     IncidentType
  upstream_live_pole_id    String?            @map("upstream_live_pole_id")
  downstream_dark_pole_ids     Json               @map("downstream_dark_pole_ids")
  affected_pole_ids            Json               @map("affected_pole_ids")
  historical_affected_pole_ids Json               @map("historical_affected_pole_ids")
  affected_count               Int                @map("affected_count")
  // Dominant edge source used to localize this incident (AUTHORITATIVE or INFERRED)
  topology_source          EdgeTopologySource @map("topology_source")
  confidence               ConfidenceLevel
  confidence_reasons       Json               @map("confidence_reasons")
  scheduled_outage_overlap Boolean            @default(false) @map("scheduled_outage_overlap")
  first_detected_at        DateTime           @default(now()) @map("first_detected_at")
  ticket                   Ticket?

  @@map("incidents")
}

model Ticket {
  id                  String      @id
  incident_id         String      @unique @map("incident_id")
  incident            Incident    @relation(fields: [incident_id], references: [id], onDelete: Cascade)
  state               TicketState @default(DETECTED)
  created_at          DateTime    @default(now()) @map("created_at")
  updated_at          DateTime    @updatedAt @map("updated_at")
  resolved_at         DateTime?   @map("resolved_at")
  verified_at         DateTime?   @map("verified_at")
  // Poles from affected_pole_ids that are still dark, populated when RESOLVED but not verifiable.
  // Null when verification has not been attempted or ticket is VERIFIED/CLOSED.
  still_dark_pole_ids Json?       @map("still_dark_pole_ids")

  @@map("tickets")
}

model SimulatorFault {
  id          String             @id
  type        SimulatorFaultType
  target      String
  injected_at DateTime           @default(now()) @map("injected_at")
  repaired_at DateTime?          @map("repaired_at")

  @@map("simulator_faults")
}

// Simulator-only ground truth store.
// Used to preserve the physical parent-child relationships for poles in
// MISSING-topology DTs, because the export-registry step strips parent_pole_id
// from the main Pole table. The production localization engine cannot see this table.
model SimTrueTopology {
  pole_id        String  @id
  parent_pole_id String? @map("parent_pole_id")

  @@map("sim_true_topology")
}
