# Database connection string for PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kspdb_fault_localization?schema=public"

# AI Explain Service API Key (Optional, graceful fallback enabled)
ANTHROPIC_API_KEY=""

# Server Configuration
PORT=3000
HOST="0.0.0.0"

# Internal Telemetry URL (for background simulator/heartbeats)
TELEMETRY_BASE_URL="http://localhost:3000"

# Simulator Configuration (1 = start emitting heartbeats automatically on server boot)
HEARTBEAT_EMITTER_STARTUP=1

# Database Seeding Control (1 = force wipe and re-seed on restart)
FORCE_RESEED=0
